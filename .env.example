# ==============================================================================
# College Event Management System - Environment Configuration
# ==============================================================================

# Flask Secret Key for Session Signing & CSRF Protection
SECRET_KEY=college-event-mgmt-super-secret-key-adbms-2026

# Flask Environment: development | production | testing
FLASK_ENV=development
DEBUG=True

# MongoDB Connection String (Supports local standalone, replica sets, and MongoDB Atlas)
# Example local: mongodb://localhost:27017/college_events_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/college_events_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/college_events_db
DATABASE_NAME=college_events_db

# File Upload Configuration
MAX_CONTENT_LENGTH=5242880 # 5 MB in bytes
UPLOAD_FOLDER=static/uploads/event_banners

# Email Verification Mode: 'local_demo' prints token in UI & logs, 'smtp' sends via mail
EMAIL_DELIVERY_MODE=local_demo

# Event Budget Breakdown Threshold (INR)
BUDGET_BREAKDOWN_THRESHOLD=10000.0
